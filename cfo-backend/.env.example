# Required for API + Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Optional: Postgres connection string for automatic migrations (Supabase Dashboard → Database → URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT for POST /login dev tokens
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Dev-only credentials for POST /login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# OpenAI — required for POST /upload embeddings and POST /question-generation
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# Storage bucket name (created by python -m app.bootstrap.run_init or manually)
STORAGE_BUCKET=company-docs
